# ── AccessAI Configuration ──────────────────────────────────────────────────
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.

# ── LLM ─────────────────────────────────────────────────────────────────────
# Set to "true" to use deterministic canned outputs (no API key needed).
MOCK_LLM=true

# OpenAI-compatible API key (used only when MOCK_LLM=false)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Sarvam AI Integration (9 Indian Languages + English) ─────────────────────
# Get key from https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_TRANSLATE_URL=https://api.sarvam.ai/translate

# ── Packet signing ───────────────────────────────────────────────────────────
# Path to the Ed25519 private key (cloud only)
PRIVATE_KEY_PATH=keys/private.key
# Path to the Ed25519 public key (hub only — never ship private key to hub)
PUBLIC_KEY_PATH=keys/public.key

# ── Cloud ────────────────────────────────────────────────────────────────────
CLOUD_DB_URL=sqlite:///./cloud/cloud.db
CLOUD_PORT=8000
PACKETS_DIR=./packets

# ── Hub ──────────────────────────────────────────────────────────────────────
HUB_DB_URL=sqlite:///./hub/hub.db
HUB_PORT=8001
HUB_PACKETS_DIR=./packets

# Transport mode: file | http
HUB_TRANSPORT=file

# When HUB_TRANSPORT=http, point to cloud sync endpoint
CLOUD_SYNC_URL=http://localhost:8000/sync

# ── Demo controls ────────────────────────────────────────────────────────────
# Fast-forward offset in days (for deadline demo)
DEMO_TIME_OFFSET_DAYS=0
